generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model game_table {
  game_id           String               @id @default(auto()) @map("_id") @db.ObjectId
  member_id         String
  game_rows         Int
  game_cols         Int
  game_level        String
  game_total_mines  Int
  game_started_at   DateTime             @default(now())
  game_ended_at     DateTime?
  game_status       game_status_enum     @default(PENDING)
  board_cells       board_cell_table[]
  game_created_at   DateTime             @default(now())
  game_updated_at   DateTime             @updatedAt
}

model board_cell_table {
  board_cell_id       String       @id @default(auto()) @map("_id") @db.ObjectId
  board_game_id       String
  cell_x              Int
  cell_y              Int
  cell_is_mine        Boolean
  cell_adjacent_count Int
  game_table          game_table   @relation(fields: [board_game_id], references: [game_id])
}

enum game_status_enum {
  PENDING
  IN_PROGRESS
  WON
  LOST
}
